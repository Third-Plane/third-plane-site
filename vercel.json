{
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/underwriting-desk", "destination": "/company", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true }
  ]
}

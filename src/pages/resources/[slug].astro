---
import { resourcesPage, site } from "../../data/content";
import { getPosts } from "../../data/get-posts";
import Base from "../../layouts/Base.astro";
import { ORIGIN, canonicalUrl } from "../../lib/head";
import { Post, PostHero } from "../../views/Post";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const path = `/resources/${post.slug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.standfirst,
    datePublished: post.date,
    author: { "@type": "Organization", name: post.author },
    publisher: { "@type": "Organization", name: site.name, logo: `${ORIGIN}/brand/mark-purple.png` },
    mainEntityOfPage: canonicalUrl(path),
    image: `${ORIGIN}/og.png`,
  },
];
---

{/* A post closes with the Resources page's call to action. */}
<Base
  path={path}
  title={post.title}
  description={post.standfirst}
  type="article"
  jsonLd={jsonLd}
  cta={resourcesPage.cta}
>
  <PostHero slot="hero" post={post} />
  <Post post={post} />
</Base>

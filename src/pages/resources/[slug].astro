---
import { resourcesPage } from "../../data/content";
import { getPosts } from "../../data/get-posts";
import Base from "../../layouts/Base.astro";
import { ORIGIN, canonicalUrl } from "../../lib/head";
import { ORGANIZATION_ID, WEBSITE_ID, authorOf } from "../../lib/schema";
import { Post } from "../../views/Post";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const path = `/resources/${post.slug}`;
const url = canonicalUrl(path);

const article = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  headline: post.title,
  description: post.standfirst,
  datePublished: post.date,
  dateModified: post.updated ?? post.date,
  author: authorOf(post.author),
  publisher: { "@id": ORGANIZATION_ID },
  mainEntityOfPage: { "@id": url },
  isPartOf: { "@id": WEBSITE_ID },
  articleSection: resourcesPage.types[post.type],
  image: `${ORIGIN}/og.png`,
  inLanguage: "en",
};
---

{/* A post closes with the Resources page's call to action. */}
<Base
  path={path}
  title={post.title}
  description={post.standfirst}
  type="article"
  schema={[article]}
  trail={[
    { name: "Resources", path: "/resources" },
    { name: post.title, path },
  ]}
  cta={resourcesPage.cta}
>
  <Post post={post} />
</Base>

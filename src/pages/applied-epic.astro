---
import { appliedEpicPage as page } from "../data/content";
import Base from "../layouts/Base.astro";
import { faqPage } from "../lib/schema";
import { AppliedEpic } from "../views/AppliedEpic";
---

<Base path="/applied-epic" title="Applied Epic" description={page.lead}
  schema={faqPage("/applied-epic", page.faq)}
  cta={page.cta}
>
  <AppliedEpic />
</Base>

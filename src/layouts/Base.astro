---
import "../tailwind.css";
import { Flowchart, type ChartName } from "../components/Flowchart";
import { Footer } from "../components/Footer";
import { site } from "../data/content";
import { DEFAULT_DESCRIPTION, ORIGIN, canonicalUrl, fullTitle } from "../lib/head";

interface Props {
  title?: string;
  description?: string;
  path: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: object[];
  chart?: ChartName;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  type = "website",
  noindex = false,
  chart = "placement",
} = Astro.props;
const full = fullTitle(title);
const canonical = canonicalUrl(path);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: `${ORIGIN}/`,
  logo: `${ORIGIN}/brand/mark-purple.png`,
  email: site.email,
  sameAs: [site.linkedin],
};
const jsonLd = Astro.props.jsonLd ?? (path === "/" ? [organization] : []);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
    <meta name="theme-color" content="#f6f3f0" />
    <script is:inline>
      // Set the reveal state before first paint so sections fade in
      // (scripts/reveal.ts) instead of showing, hiding and fading in.
      if ("IntersectionObserver" in window) document.documentElement.classList.add("reveal-ready");
    </script>

    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${ORIGIN}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />

    <link rel="preload" href="/fonts/TX-02-Data-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400&family=Karla:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {/* The page's flowchart, fixed behind everything: the hero and the bands over
         it let it show where they are see-through. It paints the hero wash under
         the chart, so the hero's colours (surface-hero) hold for it, and it is as
         tall as the largest window, so a phone's toolbar coming and going
         doesn't resize it. A page with a ledger must pass the chart the ledger
         follows (see SplitHero). */}
    <div class="surface-hero bg-hero pointer-events-none fixed inset-x-0 top-0 -z-1 h-lvh" aria-hidden="true">
      <Flowchart chart={chart} />
    </div>
    {/* A sticky hero lives here, not in <main>: it is held inside its container, so
         in <main> it would be pushed up where <main> ends. Under <body> it sticks
         to the end of the page. */}
    <slot name="hero" />
    <main class="mx-3 mb-3 relative space-y-3 z-1">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/nav";
      import "../scripts/reveal";
      import "../scripts/ledger";
      import "../scripts/particles";
      import "../scripts/flowchart";
      import "../scripts/halftone";
      import "../scripts/hero-collapse";
      import "../scripts/footer-reveal";
    </script>
  </body>
</html>

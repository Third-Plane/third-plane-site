---
import { ClientRouter } from "astro:transitions";
import "../tailwind.css";
import type { CtaCopy } from "../components/Cta";
import { Flowchart, type ChartName } from "../components/Flowchart";
import { Footer } from "../components/Footer";
import { Header } from "../components/Header";
import { DEFAULT_DESCRIPTION, ORIGIN, canonicalUrl, fullTitle } from "../lib/head";
import { pageGraph, type Crumb } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  path: string;
  type?: "website" | "article";
  noindex?: boolean;
  // The page's own structured data nodes, added to the site-wide ones (see
  // lib/schema.ts), and its breadcrumb trail after Home, if it isn't just
  // the page itself.
  schema?: object[];
  trail?: Crumb[];
  chart?: ChartName;
  // The page's call to action, shown in its footer.
  cta?: CtaCopy;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  type = "website",
  noindex = false,
  schema,
  trail = title ? [{ name: title, path }] : [],
  chart = "placement",
  cta,
} = Astro.props;
const full = fullTitle(title);
const canonical = canonicalUrl(path);
const graph = pageGraph({ title: full, description, path, trail, nodes: schema });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{full}</title>
    <meta name="description" content={description} />
    <ClientRouter />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />}
    <meta name="theme-color" content="#f6f3f0" />

    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${ORIGIN}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />

    <link rel="preload" href="/fonts/TX-02-Data-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Karla:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {/* The page's flowchart, fixed behind everything: the hero and the sections
         over it let it show where they are see-through. It paints the hero wash under
         the chart, so the hero's theme holds for it, and it is as
         tall as the largest window, so a phone's toolbar coming and going
         doesn't resize it. A page with a ledger must pass the chart the ledger
         follows (see Ledger). It is kept from page to page (transition:persist),
         running on, and types its chart out and the next page's in where the
         two differ (see scripts/flowchart.ts). */}
    <div
      class="bg-hero pointer-events-none fixed inset-x-0 top-0 -z-1 h-lvh"
      data-theme="hero"
      aria-hidden="true"
      transition:persist="backdrop"
    >
      <Flowchart chart={chart} />
    </div>
    {/* The nav, then the page: its hero, then its sections. On a page with no
         hero the first section must come straight after the nav, so that its
         copy of the bar is hidden (see the nav in tailwind.css). */}
    <Header />
    <slot />

    <Footer cta={cta} />

    <script>
      import "../scripts/deferred";
      import "../scripts/nav";
      import "../scripts/nav-theme";
      import "../scripts/ledger";
      import "../scripts/screen-cycle";
      import "../scripts/flowchart";
    </script>
  </body>
</html>

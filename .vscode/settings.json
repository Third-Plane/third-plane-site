{
  // Oxc does both jobs here: oxlint for linting (.oxlintrc.json) and oxfmt for
  // formatting (.oxfmtrc.json). The per-language entries keep a formatter set
  // for a language in someone's user settings from taking over in this repo.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    // TypeScript's own action. oxlint only offers this as a suggestion, and
    // applying suggestions on save would apply every rule's suggestions.
    "source.removeUnusedImports": "explicit"
  },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  // Tailwind IntelliSense: the stylesheet that imports Tailwind's layers.
  "tailwindCSS.experimental.configFile": "src/tailwind.css"
}
